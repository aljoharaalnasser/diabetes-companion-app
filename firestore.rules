rules_version = '2';

// Diabetes Companion - access rules (NFR-07).
// Deploy with: firebase deploy --only firestore:rules
// or paste into Firebase console > Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // An active consent link from the patient to the caller.
    function hasActiveLink(patientUid) {
      let linkId = patientUid + '_' + request.auth.uid;
      return signedIn()
        && exists(/databases/$(database)/documents/careLinks/$(linkId))
        && get(/databases/$(database)/documents/careLinks/$(linkId)).data.status == 'active';
    }

    function linkedRole(patientUid) {
      let linkId = patientUid + '_' + request.auth.uid;
      return get(/databases/$(database)/documents/careLinks/$(linkId)).data.memberRole;
    }

    function isLinkedDoctor(patientUid) {
      return hasActiveLink(patientUid) && linkedRole(patientUid) == 'doctor';
    }

    // isLinkedDoctor() trusts the memberRole on the patient-written care link. For the meal
    // insulin calculator, confirming an ICR additionally needs the caller's own profile to be
    // a doctor, so a patient can't link a second non-doctor account to confirm their own ratio.
    function isVerifiedLinkedDoctor(patientUid) {
      return isLinkedDoctor(patientUid)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    function validRole(role) {
      return role in ['patient', 'doctor', 'caregiver', 'admin'];
    }

    // The administrator role (FR-14). Self-registration cannot create one, so the first
    // admin is promoted by an existing admin, or set directly in the Firebase console.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Users -----------------------------------------------------------
    match /users/{uid} {
      // Any signed-in user can read basic directory info (needed to pick a doctor/caregiver).
      allow read: if signedIn();
      // Self-registration cannot create admins, and no account starts out suspended.
      allow create: if isSelf(uid)
        && validRole(request.resource.data.role)
        && request.resource.data.role != 'admin'
        && request.resource.data.get('accountStatus', 'active') == 'active';
      // An account may edit its own profile but can never CHANGE its own role or account
      // status, so nobody promotes themselves or lifts their own suspension. (Rewriting
      // either with the value already stored is a no-op and is allowed.) An administrator
      // may change those two fields on OTHER accounts and nothing else, which also means an
      // admin cannot demote or suspend themselves and lock the platform out (FR-14).
      //
      // Note what this does NOT do: a suspended account is refused at sign-in and has any
      // open session ended by the app, but these rules do not make its other records
      // read-only. That would need a get() on the user document in every write rule.
      allow update: if (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('accountStatus', 'active')
               == resource.data.get('accountStatus', 'active'))
        || (isAdmin()
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'accountStatus', 'updatedAt'])
          && validRole(request.resource.data.role)
          && request.resource.data.get('accountStatus', 'active') in ['active', 'suspended']);
      allow delete: if false;

      // Patient-owned records: patient full access, linked care team read-only.
      match /readings/{id} {
        allow read: if isSelf(uid) || hasActiveLink(uid);
        allow write: if isSelf(uid);
      }
      match /medications/{id} {
        allow read: if isSelf(uid) || hasActiveLink(uid);
        allow write: if isSelf(uid);
      }
      match /reminders/{id} {
        allow read, write: if isSelf(uid);
      }
      // Thresholds are set by the linked doctor and readable by the patient and care team.
      match /settings/thresholds {
        allow read: if isSelf(uid) || hasActiveLink(uid);
        allow write: if isLinkedDoctor(uid)
          && request.resource.data.criticalLow < request.resource.data.targetLow
          && request.resource.data.targetLow < request.resource.data.targetHigh
          && request.resource.data.targetHigh < request.resource.data.criticalHigh;
      }

      // ---- Meal insulin calculator: ICR versions --------------------------
      // Append-only: no version is ever updated or deleted, so every past dose suggestion
      // stays traceable to the exact ratio it used. Patient and linked doctor can read.
      // Bounds must match MealInsulinConfig.ICR_MIN/MAX_GRAMS_PER_UNIT
      // (TODO: range to be confirmed with supervisor).
      match /icrSettings/{icrId} {
        function validIcr() {
          let d = request.resource.data;
          return d.icrId == icrId
            && d.patientId == uid
            && d.gramsPerUnit is number
            && d.gramsPerUnit >= 1 && d.gramsPerUnit <= 100
            && d.version is int && d.version >= 1
            && d.status in ['UNCONFIRMED', 'CONFIRMED']
            && d.enteredBy in ['PATIENT', 'DOCTOR'];
        }

        allow read: if isSelf(uid) || isLinkedDoctor(uid);
        // The patient may only ever add an UNCONFIRMED value they entered themselves.
        // Only the linked doctor may add a CONFIRMED version (a new value, or a confirmation
        // of a patient value), and it must carry the doctor's own uid.
        allow create: if validIcr()
          && ((isSelf(uid)
                && request.resource.data.status == 'UNCONFIRMED'
                && request.resource.data.enteredBy == 'PATIENT'
                && request.resource.data.confirmedByDoctorId == '')
              || (isVerifiedLinkedDoctor(uid)
                && request.resource.data.status == 'CONFIRMED'
                && request.resource.data.confirmedByDoctorId == request.auth.uid));
        allow update, delete: if false;
      }

      // ---- Meal insulin calculator: dose suggestions ----------------------
      // The patient creates and resolves their own; the linked doctor can read them.
      match /doseSuggestions/{suggestionId} {
        function icrDoc() {
          return /databases/$(database)/documents/users/$(uid)/icrSettings/$(request.resource.data.icrId);
        }

        allow read: if isSelf(uid) || isLinkedDoctor(uid);
        // Created only as SUGGESTED, from a CONFIRMED ICR whose value matches what is stored,
        // and with the suggested units matching floor(carbs / ICR / step) * step.
        allow create: if isSelf(uid)
          && request.resource.data.suggestionId == suggestionId
          && request.resource.data.patientId == uid
          && request.resource.data.status == 'SUGGESTED'
          && request.resource.data.takenUnits == null
          && request.resource.data.confirmedCarbs is number
          && request.resource.data.confirmedCarbs > 0
          && request.resource.data.roundingStep is number
          && request.resource.data.roundingStep > 0
          && exists(icrDoc())
          && get(icrDoc()).data.status == 'CONFIRMED'
          && get(icrDoc()).data.gramsPerUnit == request.resource.data.icrValue
          && get(icrDoc()).data.version == request.resource.data.icrVersion
          && math.abs(
               math.floor(request.resource.data.confirmedCarbs / request.resource.data.icrValue
                          / request.resource.data.roundingStep + 0.000001)
                 * request.resource.data.roundingStep
               - request.resource.data.suggestedUnits) < 0.0001;
        // Resolved once, from SUGGESTED to TAKEN or SKIPPED. The calculated values can't change.
        allow update: if isSelf(uid)
          && resource.data.status == 'SUGGESTED'
          && request.resource.data.status in ['TAKEN', 'SKIPPED']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'takenUnits', 'medicationLogId', 'updatedAt'])
          && (request.resource.data.status == 'SKIPPED'
              || (request.resource.data.takenUnits is number && request.resource.data.takenUnits > 0));
        allow delete: if false;
      }

      // ---- Alerts (FR-08, FR-09, FR-10) ---------------------------------
      // The patient raises and answers their own alerts. A linked caregiver or doctor may
      // read them and record follow-up, but may not rewrite the reading they describe.
      match /alerts/{id} {
        allow read: if isSelf(uid) || hasActiveLink(uid);
        allow create: if isSelf(uid);
        allow delete: if false;
        allow update: if isSelf(uid)
          || (hasActiveLink(uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'stage', 'events',
                   'caregiverNotifiedAt', 'doctorNotifiedAt',
                   'resolvedByUid', 'resolvedByName', 'resolvedByRole',
                   'resolutionNote', 'resolvedAt'
                 ]));
      }
    }

    // ---- Administrator reporting (FR-14) ---------------------------------
    // Alerts live under the patient who owns them, so an admin has no consent link to read
    // them through. This collection-group rule gives that one role a cross-patient read of
    // alert status, and nothing else: readings, medication, conversations, insulin requests
    // and AI drafts stay out of reach, because running the platform does not need them.
    match /{path=**}/alerts/{alertId} {
      allow read: if isAdmin();
    }

    // ---- Consent links ---------------------------------------------------
    match /careLinks/{linkId} {
      // The patient, the member on the link, and anyone else already on that patient's
      // care team, so a caregiver can find the assigned doctor to contact (FR-13).
      allow read: if signedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.memberUid == request.auth.uid
            || hasActiveLink(resource.data.patientUid)
            // Admins count active cases and care-team coverage (FR-14).
            || isAdmin());
      // Only the patient can grant, and the id must be patientUid_memberUid.
      allow create: if signedIn()
        && request.resource.data.patientUid == request.auth.uid
        && linkId == request.auth.uid + '_' + request.resource.data.memberUid
        && request.resource.data.memberRole in ['doctor', 'caregiver']
        && request.resource.data.status == 'active';
      // Only the patient can revoke or re-grant. Who the link is between can never change,
      // so the identity fields must match the stored ones exactly.
      allow update: if signedIn()
        && resource.data.patientUid == request.auth.uid
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.memberUid == resource.data.memberUid
        && request.resource.data.memberRole == resource.data.memberRole
        && request.resource.data.status in ['active', 'revoked'];
      allow delete: if false;
    }

    // ---- Care-team messaging (FR-15) -------------------------------------
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      allow read, update: if isParticipant();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow delete: if false;

      // Messages are append-only: nobody may edit or delete what was said.
      match /messages/{messageId} {
        function conversationParticipants() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if signedIn() && request.auth.uid in conversationParticipants();
        allow create: if signedIn()
          && request.auth.uid in conversationParticipants()
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Insulin-advice requests (FR-17, FR-18, FR-19) -------------------
    match /insulinRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.patientUid == request.auth.uid
            || resource.data.doctorUid == request.auth.uid);
      // Only the patient raises a request, and only ever as pending.
      allow create: if signedIn()
        && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.response == null;
      // Only the assigned doctor answers it, and the patient link cannot be rewritten.
      allow update: if signedIn()
        && resource.data.doctorUid == request.auth.uid
        && request.resource.data.patientUid == resource.data.patientUid
        && request.resource.data.doctorUid == resource.data.doctorUid;
      allow delete: if false;

      // The AI draft is doctor-only. The patient is denied here, so an unreviewed draft
      // can never reach them even if the client asked for it (FR-18).
      match /private/{document} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/insulinRequests/$(requestId)).data.doctorUid == request.auth.uid;
      }
    }

    // ---- Deletion requests (NFR-10) -------------------------------------
    match /deletionRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      // Only an administrator closes a request, and only ever by marking it completed, so
      // the record of the request itself can never be rewritten or withdrawn (NFR-10).
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'completedAt', 'completedByName']);
      allow delete: if false;
    }
  }
}
